# Convex Configuration
# Run `npx convex dev` once to authenticate and get this value.
# It will also be written automatically to .env.local by the Convex CLI.
CONVEX_URL=https://your-deployment.convex.cloud

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_openai_org_id_here

# Subscription API
SUBSCRIPTION_API_URL=https://chatgpt.talhasultan.dev/api/subscriptions

# Database Configuration (for future MySQL integration)
MYSQL_HOST=localhost
MYSQL_USER=your_mysql_user
MYSQL_PASS=your_mysql_password
MYSQL_DB=chatgpt

# Telegram Bot (optional — required for Telegram webhook replies)
# Create a bot via @BotFather on Telegram, then copy the token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Microsoft OAuth — Outlook Calendar integration (optional)
# Register an app at https://portal.azure.com → App registrations.
# Required redirect URI: https://yourdomain.com/auth/outlook/callback
# Required API permissions (delegated): User.Read, Calendars.ReadWrite, offline_access
MS_CLIENT_ID=your_azure_app_client_id
MS_CLIENT_SECRET=your_azure_app_client_secret
MS_TENANT=common
MS_REDIRECT_URI=https://yourdomain.com/auth/outlook/callback

# Google OAuth — Google Calendar integration (optional)
# Register an app at https://console.cloud.google.com → APIs & Services → Credentials.
# Required OAuth 2.0 redirect URI: https://yourdomain.com/auth/google/callback
# Required APIs to enable: Google Calendar API, Google People API (or just use openid+email scopes)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# Admin diagnostics (optional)
# Protects GET /admin/health. Generate a strong random string (e.g. openssl rand -hex 32).
# If unset, the /admin/health endpoint returns 503.
ADMIN_TOKEN=your_strong_random_admin_token_here

# Reverse proxy trust (optional)
# Set to the number of proxy hops in front of this server (e.g. 1 for a single
# nginx or Heroku/Railway router). Enables correct req.ip for rate limiting.
# Leave unset when running without a reverse proxy.
TRUST_PROXY=

# Server Configuration
PORT=3000
